{
  "extraKnownMarketplaces": {
    "motion": {
      "source": {
        "source": "github",
        "repo": "GopkoDev/motion-flow"
      }
    }
  },
  "enabledPlugins": {
    "motion-flow@motion": true
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(drive-gate)",
      "Bash(drive-gate *)",
      "Bash(mf-doctor)",
      "Bash(mf-doctor *)",
      "Bash(mf-gate)",
      "Bash(mf-gate *)",
      "Bash(mf-init)",
      "Bash(mf-init *)",
      "Bash(mf-setup)",
      "Bash(mf-setup *)",
      "Bash(mf-sum)",
      "Bash(mf-sum *)",
      "Bash(mf-whatsnew)",
      "Bash(mf-whatsnew *)",
      "Bash(ae-run)",
      "Bash(ae-run *)",
      "Bash(ae-dump)",
      "Bash(ae-dump *)",
      "Bash(ae-render-frame)",
      "Bash(ae-render-frame *)",
      "Bash(ae-lint)",
      "Bash(ae-lint *)",
      "Bash(aep-version)",
      "Bash(aep-version *)",
      "Bash(mf-studio)",
      "Bash(mf-studio *)",
      "Bash(mf-sheet)",
      "Bash(mf-sheet *)"
    ],
    "deny": [
      "Read(//REPLACE/WITH/ABSOLUTE/DRIVE/ROOT/**)",
      "Edit(//REPLACE/WITH/ABSOLUTE/DRIVE/ROOT/**)",
      "Edit(~/.motion-flow/**)",
      "mcp__claude_ai_Google_Drive__trash_file",
      "mcp__claude_ai_Google_Drive__update_file",
      "mcp__claude_ai_Google_Drive__share_file",
      "mcp__claude_ai_Google_Drive__create_file",
      "mcp__claude_ai_Google_Drive__copy_file"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(git checkout --force*)",
      "Bash(git checkout -f*)"
    ]
  }
}
