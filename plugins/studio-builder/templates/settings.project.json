{
  "extraKnownMarketplaces": {
    "motion": {
      "source": {
        "source": "github",
        "repo": "GopkoDev/motion-flow"
      }
    }
  },
  "enabledPlugins": {
    "studio-builder@motion": true
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(drive-gate)",
      "Bash(drive-gate *)",
      "Bash(sb-init)",
      "Bash(sb-init *)",
      "Bash(sb-corpus)",
      "Bash(sb-corpus *)",
      "Bash(mf-studio)",
      "Bash(mf-studio *)",
      "Bash(mf-flow)",
      "Bash(mf-flow *)",
      "Bash(ae-run)",
      "Bash(ae-run *)",
      "Bash(ae-dump)",
      "Bash(ae-dump *)",
      "Bash(ae-render-frame)",
      "Bash(ae-render-frame *)",
      "Bash(sb-export)",
      "Bash(sb-export *)"
    ],
    "deny": [
      "Read(//REPLACE/WITH/ABSOLUTE/DRIVE/ROOT/**)",
      "Edit(//REPLACE/WITH/ABSOLUTE/DRIVE/ROOT/**)",
      "Edit(~/.motion-flow/**)",
      "mcp__claude_ai_Google_Drive__trash_file",
      "mcp__claude_ai_Google_Drive__update_file",
      "mcp__claude_ai_Google_Drive__share_file",
      "mcp__claude_ai_Google_Drive__create_file",
      "mcp__claude_ai_Google_Drive__copy_file"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(git checkout --force*)",
      "Bash(git checkout -f*)"
    ]
  }
}
